# Server Configuration
PORT=3456
NODE_ENV=production
SESSION_SECRET=nutritrack_super_secret_session_key

# Gmail Configuration (For reminders)
# Go to Google Account -> Security -> 2-Step Verification -> App Passwords to create a password
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password
RECIPIENT_EMAIL=nguyentuanqnpc@gmail.com

# Synchronization Configuration
# Laptop: set IS_LAPTOP=true, and SYNC_TARGET_URL to your PC's Ngrok or IP address
# PC: set IS_LAPTOP=false, and leave SYNC_TARGET_URL empty
IS_LAPTOP=true
SYNC_TARGET_URL=http://your-work-pc-ngrok-url-or-ip
